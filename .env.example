BARK_SERVER=https://api.day.app
# ntfy（Android/iPhone）：主题即密码，请用 20 位以上随机字符；受保护/自建服务器填 NTFY_SERVER、NTFY_TOKEN
NTFY_TOPIC=
NTFY_SERVER=https://ntfy.sh
NTFY_TOKEN=
